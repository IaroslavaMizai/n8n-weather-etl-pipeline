    {
      "parameters": {
        "jsCode": "const weather =\n  $input.all()[0].json; const current =\n  weather.current_condition[0]; const area =\n  weather.nearest_area[0]; const city = area.areaName[0].value;\n  const fetchedAt = new Date().toISOString();\n  return [{\n    json: {\n      city: city,\n      temp_c: parseFloat(current.temp_C),\n      humidity: parseFloat(current.humidity),\n      description: current.weatherDesc[0].value,\n      fetched_at: fetchedAt,\n      date_key: city + '_' + fetchedAt.split('T')[0]\n    }\n  }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        -144
      ],
      "id": "7ba4d488-11ec-459f-becd-1f30e929f833",
