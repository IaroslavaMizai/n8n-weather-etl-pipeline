      "name": "Add Batch Timestamp"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n  const issues = [];\n  for (const item of items) {\n    if (!item.json.city || item.json.city.trim() === '') {\n      issues.push('Empty city found');\n    }\n    if (item.json.temp_c === undefined || isNaN(item.json.temp_c) || item.json.temp_c < -100 || item.json.temp_c > 60) {\n      issues.push('Invalid temp_c: ' + item.json.temp_c);\n    }\n  }\n  return [{ json: { pass: issues.length === 0, total: items.length, issues: issues } }];"
      },
