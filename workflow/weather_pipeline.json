      "name": "Check Existing Records",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const existingRecords =\n  $('Check Existing Records').all(); const storedKeys =\n  existingRecords.map(r => r.json.date_key); const items =\n  $('Transform Data').all(); const newItems = items.filter(item => {\n    const dateKey = item.json.city + '_' + item.json.fetched_at.split('T')[0];\n    return !storedKeys.includes(dateKey);\n  }); if (newItems.length === 0) {\n    return [];\n  }\n  return newItems;"
      },
